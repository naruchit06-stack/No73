# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Long random string used to sign the login session cookie
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)
DATABASE_SSL=true         # true for cloud MySQL (TiDB Cloud, Aiven, ...); false for local MySQL

# ── Google login (https://console.cloud.google.com → APIs & Services → Credentials) ──
GOOGLE_CLIENT_ID=         # OAuth client ID (type: Web application)
GOOGLE_CLIENT_SECRET=     # OAuth client secret
# Authorized redirect URI to add in Google Console:  https://YOUR-DOMAIN/api/oauth/callback
#                                       (and for local dev: http://localhost:3000/api/oauth/callback)

# ── Admin ───────────────────────────────────────────────────────
OWNER_EMAIL=              # Google account email that becomes admin (หลังบ้าน) when it signs in

# ── File storage (covers + audio) — any S3-compatible service ──
S3_BUCKET=                # private bucket name
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto            # AWS: ap-southeast-1 etc. · Cloudflare R2: auto
S3_ENDPOINT=              # blank for AWS S3 · R2: https://<account-id>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=false # true for MinIO

# ── Optional ────────────────────────────────────────────────────
APP_URL=                  # Public origin, e.g. https://no73.example.com (only if behind a proxy)
